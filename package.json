	"scripts": {
		"start": "webpack --mode development --env dev -w",
		"watch": "web-ext run -s dist/",
		"build": "webpack --mode production --env prod",
		"dist": "npm run build && web-ext build -s dist/",
		"build-dev": "webpack --mode development --env dev",
		"dist-dev": "npm run build-dev && web-ext build --overwrite-dest -s dist/",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^7.7.0",
		"@typescript-eslint/parser": "^7.7.0",
		"@webdiscus/pug-loader": "^2.11.0",
		"copy-webpack-plugin": "^12.0.2",
		"css-loader": "^7.1.1",
		"eslint": "^8.56.0",
		"mini-css-extract-plugin": "^2.9.0",
		"pug": "^3.0.2",
		"sass": "^1.75.0",
		"sass-loader": "^14.2.1",
		"ts-loader": "^9.5.1",
		"typescript": "^5.4.5",
		"web-ext": "^7.11.0",
		"web-ext-types": "^3.2.1",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"photon-colors": "^3.3.2"
	}
}
