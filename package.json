		"pug": "^3.0.3",
		"sass": "^1.94.2",
		"sass-loader": "^16.0.6",
		"ts-loader": "^9.5.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.0",
		"web-ext": "^9.2.0",
		"web-ext-types": "^3.2.1",
		"webpack": "^5.103.0",
		"webpack-cli": "^6.0.1"
